# Resend — https://resend.com/api-keys
RESEND_API_KEY=
# Email address that receives contact form submissions
CONTACT_TO_EMAIL=sagor@sagorahmed.com
# Verified sender — must be on a domain you've verified in Resend
CONTACT_FROM_EMAIL=Sagor Ahmed <noreply@sagorahmed.com>

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
